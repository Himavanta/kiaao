  },
  "license": "MIT",
  "author": "Himavanta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himavanta/kiaao.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./astro": "./dist/astro/index.js",
    "./astro/client": "./dist/astro/client.js",
    "./astro/server": "./dist/astro/server.js",
    "./jsx-dev-runtime": "./dist/jsx-dev-runtime.js",
    "./jsx-runtime": "./dist/jsx-runtime.js",
    "./router": "./dist/router.js",
    "./server": "./dist/server.js",
