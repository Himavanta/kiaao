{
  "name": "kiaao",
  "version": "0.6.2",
  "description": "A pure-runtime, zero-virtual-DOM reactive UI framework. No Proxy, no compiler dependency, every update is a precise DOM operation.",
  "keywords": [
    "framework",
    "frontend",
    "no-vdom",
    "reactive",
    "signals"
  ],
  "homepage": "https://github.com/Himavanta/kiaao#readme",
  "bugs": {
    "url": "https://github.com/Himavanta/kiaao/issues"
  },
  "license": "MIT",
  "author": "Himavanta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himavanta/kiaao.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./adapter": "./dist/adapter/index.js",
    "./astro": "./dist/astro/index.js",
    "./astro/client": "./dist/astro/client.js",
    "./astro/server": "./dist/astro/server.js",
    "./core": "./dist/core/index.js",
    "./dom": "./dist/dom/index.js",
    "./jsx-dev-runtime": "./dist/jsx-dev-runtime/index.js",
    "./jsx-runtime": "./dist/jsx-runtime/index.js",
    "./lynx": "./dist/lynx/index.js",
    "./lynx/jsx-runtime": "./dist/lynx/jsx-runtime.js",
    "./motion": "./dist/motion/index.js",
    "./router": "./dist/router/index.js",
    "./server": "./dist/server/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "happy-dom": "^20.10.1",
    "motion": "^12.40.0",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.5.2"
}
