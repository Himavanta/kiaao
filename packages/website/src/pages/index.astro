---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import Counter from "../components/Counter";
---

<Layout>
  <Welcome />
  <Counter />
  <Counter client:only />
</Layout>

<style>
  :global(.counter-card) {
    position: fixed;
    bottom: 16px;
    left: 16px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(50px);
    border-radius: 16px;
    border: 1px solid white;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family:
      Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
      sans-serif;
    z-index: 10;
  }
  :global(.counter-card p) {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    min-width: 60px;
  }
  :global(.counter-btn) {
    padding: 6px 14px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    background: white;
    cursor: pointer;
    font-size: 14px;
    color: #111827;
    transition: background 0.15s;
  }
  :global(.counter-btn:hover) {
    background: #f3f4f6;
  }
  :global(.counter-btn.reset) {
    color: #ef4444;
    border-color: #fca5a5;
  }
</style>
